# ============================================================
# OfferPilot — Environment Variables
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/offerpilot"

# Auth
AUTH_SECRET="change-me-to-a-random-secret"

# LLM API (OpenAI 兼容接口，支持切换供应商)
# 火山方舟(Volcengine Ark)：
#   LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
#   LLM_MODEL 填模型 ID(如 doubao-seed-2-1-pro-260628)或自建推理接入点 ID(ep-xxx)
# 其他可选：DeepSeek(https://api.deepseek.com, deepseek-chat) / 通义千问 / OpenAI 官方
# 注意：pro 级推理模型分析较慢(数十秒)，可换轻量模型提速
LLM_API_KEY="your-api-key"
LLM_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
LLM_MODEL="doubao-seed-2-1-pro-260628"

# File Storage
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=10485760  # 10MB

# URL Fetch
PLAYWRIGHT_HEADLESS=true
