{
  "name": "offerpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && prisma generate",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx scripts/seed-role-profiles.ts",
    "build:cf": "rm -rf .next .open-next && DEPLOY_TARGET=cloudflare opennextjs-cloudflare build",
    "deploy:cf": "pnpm build:cf && wrangler deploy",
    "dev:cf": "wrangler dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6",
    "@uiw/react-md-editor": "^4.1.1",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2",
    "cheerio": "^1",
    "dayjs": "^1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9",
    "jspdf": "^4.2.1",
    "next": "16.2.12",
    "openai": "^4",
    "pdf-parse": "^1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "prisma": "^6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^14",
    "recharts": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "rclone.js": "^0.6.6",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "rclone.js",
      "workerd"
    ]
  }
}
